#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp UP
                &kp LCTRL  &kp LGUI   &kp LALT   &mo 1      &kp SPACE              &kp ENTER  &kp LEFT   &bootloader &sys_reset
            >;
        };

        setup_layer {
            bindings = <
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
                &kp ESC    &kp TAB    &kp BSPC   &kp DEL    &kp MINUS  &kp EQUAL  &kp HOME   &kp PG_DN  &kp PG_UP  &kp END
                &bootloader &sys_reset &trans     &trans     &trans                 &trans     &trans     &trans     &trans
            >;
        };
    };
};
