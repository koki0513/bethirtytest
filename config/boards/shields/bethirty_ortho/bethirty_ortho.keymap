#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
    quick-tap-ms = <0>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <250>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_s_x_lpar {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <11 21>;
            bindings = <&kp LS(N9)>;
        };

        combo_x_c_lbrace {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <21 22>;
            bindings = <&kp LS(LEFT_BRACKET)>;
        };
    };

    behaviors {
        hml_cs: homerow_mod_left_ctrl_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_CTRL_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38>;
            hold-trigger-on-release;
            hold-while-undecided;
            bindings = <&kp>, <&kp>;
        };

        hml_wa: homerow_mod_left_win_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_WIN_ALT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr_cs: homerow_mod_right_ctrl_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_CTRL_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            hold-trigger-on-release;
            hold-while-undecided;
            bindings = <&kp>, <&kp>;
        };

        hmr_wa: homerow_mod_right_win_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_WIN_ALT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q                &kp W                &kp E                &kp R                &kp T                &kp Y                &kp U                &kp I                &kp O                &kp P
                &lt 2 A              &hml_cs LCTRL S      &hml_wa LALT D       &hml_cs LSHIFT F     &hml_wa LGUI G       &hmr_wa RGUI H       &hmr_cs RSHIFT J     &hmr_wa RALT K       &hmr_cs RCTRL L      &kp SEMI
                &kp Z                &kp X                &kp C                &kp V                &kp B                &kp N                &kp M                &kp COMMA            &kp DOT              &kp SLASH
                &kp LCTRL            &kp LGUI             &lt 3 BSPC           &lt 1 LANG2          &lt 5 ENTER          &lt 4 SPACE          &kp LANG1            &bootloader          &sys_reset
            >;
        };

        layer_1 {
            bindings = <
                &trans               &trans               &trans               &trans               &kp SINGLE_QUOTE     &kp LS(SINGLE_QUOTE) &kp N7               &kp N8               &kp N9               &kp EQUAL
                &kp LEFT_BRACKET     &kp RIGHT_BRACKET    &kp LS(N9)           &kp LS(N0)           &kp GRAVE            &kp MINUS            &kp N4               &kp N5               &kp N6               &kp LS(SEMI)
                &kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &kp LS(COMMA)        &kp LS(DOT)          &kp LS(GRAVE)        &kp LS(INT_RO)       &kp N1               &kp N2               &kp N3               &mt LSHIFT N8
                &trans               &trans               &trans               &trans               &trans               &kp N0               &trans               &trans               &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &kp UP_ARROW         &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &kp LEFT_ARROW       &kp DOWN_ARROW       &kp RIGHT_ARROW      &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        layer_3 {
            bindings = <
                &trans               &trans               &trans               &kp LG(R)            &trans               &trans               &kp LS(N7)           &kp LS(N8)           &kp LS(N9)           &kp LS(EQUAL)
                &trans               &kp LG(LS(S))        &trans               &kp LC(LS(F))        &trans               &trans               &kp LS(N4)           &kp LS(N5)           &kp LS(N6)           &trans
                &trans               &trans               &trans               &kp LG(V)            &trans               &kp BACKSLASH        &kp LS(N1)           &kp LS(N2)           &kp LS(N3)           &kp LS(BACKSLASH)
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        layer_4 {
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        layer_5 {
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };

        layer_6 {
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
        };
    };
};
